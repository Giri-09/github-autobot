# Neon pooled connection string, used at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Neon direct (non-pooled) connection string, used for one-off admin/DDL work
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Port this server listens on
PORT=4000

# Shared secret the frontend must send on every internal API call — generate with: openssl rand -hex 32
INTERNAL_API_SECRET=""

# Shared secret for verifying GitHub webhook signatures — generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=""

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=""
