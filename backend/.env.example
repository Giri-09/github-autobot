# Neon pooled connection string, used at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Neon direct (non-pooled) connection string, used for one-off admin/DDL work
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Port this server listens on
PORT=4000

# Shared secret the frontend must send on every internal API call — generate with: openssl rand -hex 32
INTERNAL_API_SECRET=""

# Public base URL of this backend, used to build the webhook URL GitHub posts to.
# Must be reachable from the internet (GitHub rejects localhost).
WEBHOOK_BASE_URL="https://your-app.example.com"

# Shared secret for verifying GitHub webhook signatures — generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=""

# Slack Incoming Webhook URL (optional — without it, Slack notifications are recorded as failures)
SLACK_WEBHOOK_URL=""

# Optional free-tier AI: Google AI Studio API key (no card) + model name.
# When set, every issue/PR event gets an AI summary shown on the dashboard and
# included in Slack notifications for rules with "Include AI summary" enabled.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
