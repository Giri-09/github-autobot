# Auth.js session encryption key — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of this app (Auth.js needs this explicitly, especially in prod behind a proxy)
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Base URL of this deployment (used to register the GitHub webhook)
APP_URL="http://localhost:3000"

# Base URL of the backend service
BACKEND_URL="http://localhost:4000"
# Shared secret sent on every backend call — must match the backend's INTERNAL_API_SECRET
INTERNAL_API_SECRET=""
