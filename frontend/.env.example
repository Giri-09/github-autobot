# Neon pooled connection string, used at runtime
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Neon direct (non-pooled) connection string, used by Prisma Migrate
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js session encryption key — generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth App credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Base URL of this deployment (used to register the GitHub webhook)
APP_URL="http://localhost:3000"

# Shared secret for verifying GitHub webhook signatures — generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=""

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=""
